# Auth Service 환경변수
#
# [로컬 최초 설정 — 3단계]
# 1. cp .env.example .env
# 2. ./gradlew generateJwtKeys        ← JWT RSA 키 자동 생성 (keys/ 폴더)
# 3. .env 에서 PORTONE_API_SECRET, CI_HASH_KEY 채우기 (CI_HASH_KEY: openssl rand -base64 32)
#
# DB — 팀 공용 MySQL 고정 (G40 192.168.10.45:3307). 비밀번호만 본인 값으로 입력.
SPRING_DATASOURCE_URL=jdbc:mysql://192.168.10.45:3307/auth_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your-password-here

# ★ 직접 입력 (PortOne 콘솔 → V2 API Secret)
PORTONE_API_SECRET=

# CI HMAC 키 — 본인 환경마다 고유 값 (Base64, 디코딩 시 ≥16 bytes)
# 생성: openssl rand -base64 32
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
CI_HASH_KEY=

# reCAPTCHA — Google reCAPTCHA v2 Secret (5번째 로그인 실패 직후 CAPTCHA 요구)
# 로컬에서 captcha 없이 테스트하려면 CAPTCHA_ENABLED=false
CAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=
# siteverify 응답 hostname 허용(쉼표 구분, exact match). prod 필수 — 비우면 CAPTCHA 전부 거부
AUTH_CAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1,valuehub.example.com
# AUTH_CAPTCHA_CHALLENGE_MAX_AGE_SECONDS=120
# AUTH_CAPTCHA_CONNECT_TIMEOUT_MILLIS=2000
# AUTH_CAPTCHA_READ_TIMEOUT_MILLIS=3000

# 의존성 장애 503 Retry-After(초)
# AUTH_DEPENDENCY_RETRY_AFTER_SECONDS=5

# PortOne HTTP 타임아웃(ms)
# PORTONE_CONNECT_TIMEOUT_MILLIS=2000
# PORTONE_READ_TIMEOUT_MILLIS=5000

# refresh·logout Origin 허용 (FE URL, 쉼표 구분, exact match — scheme+host+port)
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# local/dev: require-origin=false(기본). prod(application-prod.yml): require-origin=true 고정, AUTH_ALLOWED_ORIGINS 필수
# prod startup: localhost/127.0.0.1·와일드카드·중복·빈 항목·비 http(s) Origin → 기동 실패
# AUTH_REQUIRE_ORIGIN=false

# HttpOnly JWT 쿠키 — Gateway·FO와 동일 이름·path 유지
AUTH_COOKIE_ACCESS_NAME=vh_access_token
AUTH_COOKIE_REFRESH_NAME=vh_refresh_token
# AUTH_COOKIE_PATH=/
# AUTH_COOKIE_REFRESH_PATH=/
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAME_SITE=Lax

# 로그인 실패·CAPTCHA·잠금 (기본값은 application.yml — 변경 시에만 설정)
# AUTH_LOGIN_CAPTCHA_THRESHOLD=5
# AUTH_LOGIN_LOCK_THRESHOLD=6
# AUTH_LOGIN_LOCK_MINUTES=1
# AUTH_LOGIN_FAIL_WINDOW_MINUTES=10

# IP sign-in rate limit (loginId fail count와 독립, POST /auth/sign-in만)
# AUTH_LOGIN_RATE_LIMIT_ENABLED=true
# AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
# AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_LOGIN_RATE_LIMIT_BLOCK_SECONDS=60

# Tomcat internal-proxies — 게이트웨이(사설망) IP만 X-Forwarded-For 신뢰 (직접 접속 spoofing 방지)
# AUTH_TRUSTED_PROXY_PATTERNS=127\\.0\\.0\\.1|10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[0-1])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}

# JWT RS256 — generateJwtKeys 로 생성된 Private Key (수동 입력 불필요)
JWT_PRIVATE_KEY_LOCATION=file:./keys/jwt-private.pem

# Redis — docker compose up -d (auth-service 루트)
REDIS_HOST=localhost
REDIS_PORT=6379

# 선택
# JWT_ACCESS_TOKEN_MINUTES=15
# JWT_REFRESH_TOKEN_DAYS=14
# AUTH_SIGNUP_COMPLETION_TOKEN_SECONDS=120
# PORTONE_BASE_URL=https://api.portone.io

# dev / prod
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery:8761/eureka
#
# prod 필수 (application-prod.yml + startup validator — 환경 변수 override 시에도 준수)
# SPRING_PROFILES_ACTIVE=prod
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate          ← update/create/create-drop/none 금지
# SPRING_JPA_SHOW_SQL=false
# SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false
# SPRINGDOC_API_DOCS_ENABLED=false
# SPRINGDOC_SWAGGER_UI_ENABLED=false
# AUTH_ALLOWED_ORIGINS=https://your-production-frontend.example.com  (localhost/127.0.0.1 금지)
# AUTH_CAPTCHA_ALLOWED_HOSTNAMES=your-production-hostname.example.com
# 위 prod JPA·Swagger 값을 true/update 등으로 override하면 기동 실패
